############
# Database - You can change these to any PostgreSQL database that has logical replication enabled.
############

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# default user is postgres


############
# Supavisor -- Database pooler
############
# Port Supavisor listens on for transaction pooling connections
POOLER_PROXY_PORT_TRANSACTION=6543
# Maximum number of PostgreSQL connections Supavisor opens per pool
POOLER_DEFAULT_POOL_SIZE=20
# Maximum number of client connections Supavisor accepts per pool
POOLER_MAX_CLIENT_CONN=100
# Unique tenant identifier
POOLER_TENANT_ID=your-tenant-id
# Pool size for internal metadata storage used by Supavisor
# This is separate from client connections and used only by Supavisor itself
POOLER_DB_POOL_SIZE=5


############
# API Proxy - Configuration for the Kong Reverse proxy.
############

KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443


############
# API - Configuration for PostgREST.
############

PGRST_DB_SCHEMAS=public,storage,graphql_public


############
# Auth - Configuration for the GoTrue authentication server.
############

## General
# Public frontend URL. Feeds GoTrue's auth mails AND, as NUXT_PUBLIC_SITE_URL,
# the QR codes printed on machine signs — so it must be the address a customer
# can reach from outside, not a LAN address.
SITE_URL=http://localhost:3000

# Android app signing certificate SHA-256 (Play Console → Test and release →
# App integrity → App signing key certificate; add the upload key's too if you
# sideload release builds), comma-separated. Published at
# ${SITE_URL}/.well-known/assetlinks.json so Google Password Manager / 1Password
# offer the dashboard login inside the Android app. Leave empty if you don't
# ship the app for this domain. The iOS counterpart
# (/.well-known/apple-app-site-association) needs no setting.
ANDROID_APP_SHA256=
ADDITIONAL_REDIRECT_URLS=
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
API_EXTERNAL_URL=http://localhost:8000

## Mailer Config
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

## Email auth
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=fake_sender
ENABLE_ANONYMOUS_USERS=false

## Phone auth
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false


############
# Studio - Configuration for the Dashboard
############

STUDIO_DEFAULT_ORGANIZATION="Default Organization"
STUDIO_DEFAULT_PROJECT="Default Project"

# Replace if you intend to use Studio outside of localhost
SUPABASE_PUBLIC_URL=http://localhost:8000

# Enable webp support
IMGPROXY_ENABLE_WEBP_DETECTION=true

# Add your OpenAI API key to enable SQL Editor Assistant
OPENAI_API_KEY=


############
# Functions - Configuration for Functions
############
# NOTE: VERIFY_JWT applies to all functions. Per-function VERIFY_JWT is not supported yet.
FUNCTIONS_VERIFY_JWT=false


############
# Logs - Configuration for Analytics
# Please refer to https://supabase.com/docs/reference/self-hosting-analytics/introduction
############

# Change vector.toml sinks to reflect this change
# these cannot be the same value
LOGFLARE_PUBLIC_ACCESS_TOKEN=your-super-secret-and-long-logflare-key-public
LOGFLARE_PRIVATE_ACCESS_TOKEN=your-super-secret-and-long-logflare-key-private

# Docker socket location - this value will differ depending on your OS
DOCKER_SOCKET_LOCATION=/var/run/docker.sock

# Google Cloud Project details
GOOGLE_PROJECT_ID=GOOGLE_PROJECT_ID
GOOGLE_PROJECT_NUMBER=GOOGLE_PROJECT_NUMBER

##########
# MQTT
#########

# How the SERVER reaches the broker: the compose service name, over the
# internal Docker network. Never a public hostname. docker-compose.yml pins
# this per service, so the value here is documentation for the split below.
MQTT_HOST=broker
MQTT_WS_PORT=9001
MQTT_WEBHOOK_SECRET=change-me-to-a-random-secret

# MQTT credentials
# Devices use hardcoded vmflow/vmflow. Admin is used by forwarder + edge functions.
MQTT_ADMIN_USER=admin
MQTT_ADMIN_PASS=admin

# How the DEVICES reach the broker: returned by claim-device during
# provisioning and written into the ESP32's NVS, so it must resolve from out
# in the field. Set to a LAN IP for local dev (e.g. 10.0.1.181) or a public
# domain for production. MQTT_PUBLIC_PORT doubles as the port docker-compose
# publishes the broker on.
MQTT_PUBLIC_HOST=mqtt.vmflow.xyz
MQTT_PUBLIC_PORT=1883

##########
# Push Notifications (VAPID)
# Generated automatically by setup.sh. To generate manually, see PROD.md.
#########

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com

##########
# Firebase Cloud Messaging (FCM) — for native iOS/Android push notifications
# Paste the full JSON content of your Firebase service account key.
# Leave empty to disable native push (web push via VAPID still works).
#########

FCM_SERVICE_ACCOUNT_JSON=

##########
# Apple Push Notification Service (APNs) — for native iOS push notifications
# Get these from Apple Developer Portal → Certificates, Identifiers & Profiles → Keys → APNs key.
# APNS_PRIVATE_KEY: paste the full .p8 file contents (including BEGIN/END lines).
# APNS_TOPIC: your iOS app bundle identifier.
# APNS_PRODUCTION: set to "true" for production, "false" for sandbox/development.
# Leave APNS_KEY_ID empty to disable iOS push (web push via VAPID still works).
#########

APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=com.vmflow.VMflow
APNS_PRODUCTION=false

##########
# GitHub Firmware Builds
# Set to your GitHub repo (owner/repo) to enable GitHub release imports on the firmware page.
# Leave empty to disable.
#########

GITHUB_FIRMWARE_REPO=

##########
# Frontend Environment Indicator
# Empty / "prod" / "production" → no banner. Otherwise → banner with this name.
# Color: red, amber, orange, purple, blue (default: amber)
#########
ENV_NAME=
ENV_COLOR=
