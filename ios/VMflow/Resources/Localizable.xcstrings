      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Credits the machine as if a coin or card payment had been made. No sale is recorded until the machine reports a vend."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibt dem Automaten ein Guthaben gut, als wäre eine Münz- oder Kartenzahlung erfolgt. Ein Verkauf wird erst erfasst, wenn der Automat eine Ausgabe meldet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crédite la machine comme si un paiement en pièces ou par carte avait été effectué. Aucune vente n'est enregistrée tant que la machine ne signale pas une distribution."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijft de automaat tegoed bij alsof er met munten of kaart betaald is. Er wordt pas een verkoop geregistreerd zodra de automaat een uitgifte meldt."
          }
        }
      }
    },
