    "Requested by the office. Untick a slot to leave it as it is this time; it stays open for a later tour." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vom Büro gewünscht. Haken entfernen, um ein Fach diesmal so zu lassen; es bleibt für eine spätere Tour offen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandé par le bureau. Décochez un emplacement pour le laisser tel quel cette fois ; il reste ouvert pour une tournée ultérieure."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gevraagd door kantoor. Vink een vak uit om het deze keer te laten zoals het is; het blijft open voor een latere ronde."
          }
        }
      }
    },
