    "You are not a member of any organization yet. Please create or join one using the web dashboard." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n'êtes membre d'aucune organisation pour le moment. Veuillez en créer une ou en rejoindre une via le tableau de bord web."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U bent nog geen lid van een organisatie. Maak er een aan of word lid via het webdashboard."
          }
        }
      }
    },
    "You are the only admin of %@. Deleting your account will also permanently delete the company and all of its data — machines, sales, warehouse stock, registered devices, and the cash book." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist der einzige Admin von %@. Wenn du dein Konto löschst, werden auch das Unternehmen und alle zugehörigen Daten endgültig gelöscht – Automaten, Verkäufe, Lagerbestand, registrierte Geräte und die Kasse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes le seul administrateur de %@. La suppression de votre compte supprimera également définitivement l'entreprise et toutes ses données — machines, ventes, stock d'entrepôt, appareils enregistrés et la caisse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U bent de enige beheerder van %@. Het verwijderen van uw account verwijdert ook permanent het bedrijf en alle bijbehorende gegevens — machines, verkopen, magazijnvoorraad, geregistreerde apparaten en het kasboek."
          }
        }
      }
    },
    "You have an unfinished refill tour. Would you like to continue where you left off?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast eine unvollständige Befüllungstour. Möchtest du dort weitermachen, wo du aufgehört hast?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez une tournée de réapprovisionnement inachevée. Voulez-vous continuer où vous vous étiez arrêté ?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U heeft een onafgeronde bijvulronde. Wilt u doorgaan waar u gebleven was?"
          }
        }
      }
    },
