    "A weak signal can cause connection drops. Move the router or a repeater closer to the machine.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schwacher Empfang kann zu Verbindungsabbrüchen führen. Router oder Repeater näher an den Automaten stellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un signal faible peut provoquer des coupures. Rapprochez le routeur ou un répéteur du distributeur."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een zwak signaal kan verbindingsonderbrekingen veroorzaken. Zet de router of een repeater dichter bij de automaat."
          }
        }
      }
    }
