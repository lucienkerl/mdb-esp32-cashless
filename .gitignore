.superpowers/
kicad/**/*-backups
kicad/**/fp-info-cache
kicad/**/*.lck
kicad/**/*_prl
kicad/do-not-scan_folder/
kicad/**/*.7z

# Xcode per-user UI state (Apple standard: never commit)
**/xcuserdata/

Docker/vuejs/package-lock.json

**/managed_components
**/build
**/sdkconfig.old
**/.idea/*

.vscode/*

# VS Code Local History extension snapshots
**/.history/

.project

.temp

.cache

.claude

# Git worktrees (superpowers workflow)
.worktrees/

# Docker runtime data (secrets)
Docker/.env
Docker/supabase/.env
Docker/mqtt/data/
Docker/volumes/db/data/
Docker/volumes/storage/
Docker/supabase/migrations.db

# Prod→dev data sync (scripts/sync-prod-to-dev.sh)
tmp/sync/
scripts/sync-prod-to-dev.env

# Prod→test data sync (scripts/sync-prod-to-test.sh)
tmp/sync-test/
scripts/sync-prod-to-test.env

# Signing keys and certificates — never commit these.
# ios/AuthKey_*.p8 is the APNs signing key: one `git add -A` would put it in
# the history, and getting it back out means a rewrite plus key rotation.
*.p8
*.p12
*.pem
*.jks
*.keystore
*.mobileprovision
